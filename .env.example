# MetaOps AI server environment (copy to .env; never commit .env)
PORT=8790
HOST=0.0.0.0
# Secret for session tokens + encryption of stored Meta access tokens. Generate: openssl rand -hex 32
METAOPS_SECRET=change-me-in-local-dev-only
# Meta Model API key (server-side only, never sent to clients)
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
METAOPS_MODEL=muse-wonder-1.0
METAOPS_MODEL_ALT=muse-spark-1.3
# Meta Graph API version for platform adapters
GRAPH_API_VERSION=v21.0

# Meta app (developer console) — enables webhook signature verification + the
# data-deletion callback. Server-side only.
META_APP_SECRET=
# Token you invent and paste into the app's Webhooks settings (verification handshake)
META_WEBHOOK_VERIFY_TOKEN=
# Public origin of this server (used in data-deletion status URLs)
PUBLIC_BASE_URL=http://localhost:8790
